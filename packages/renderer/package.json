{
  "name": "@formulaxjs/renderer",
  "version": "0.2.1",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "FormulaX renderer protocol and standard, kity, and image rendering entries.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vndmea/formulaX.git",
    "directory": "packages/renderer"
  },
  "keywords": [
    "formulax",
    "formula",
    "renderer",
    "svg"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./standard": {
      "types": "./dist/standard.d.ts",
      "import": "./dist/standard.js",
      "require": "./dist/standard.cjs"
    },
    "./kity": {
      "types": "./dist/kity.d.ts",
      "import": "./dist/kity.js",
      "require": "./dist/kity.cjs"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js",
      "require": "./dist/image.cjs"
    }
  },
  "unpkg": "./dist/index.global.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --config ../../tsup.config.mjs",
    "clean": "Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue",
    "test": "vitest run --root ../.. packages/renderer/test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@formulaxjs/runtime": "workspace:*",
    "@formulaxjs/runtime-kity": "workspace:*"
  }
}
